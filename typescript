// frontend/app/inventory/page.tsx
import Link from 'next/link'
import { useEffect, useState } from 'react'

interface InventoryItem {
  id: string
  name: string
  description: string
  quantity: number
}

const MOCK_DATA_URL = '/mock-data/inventory.json'

export default function InventoryPage() {
  const [items, setItems] = useState<InventoryItem[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    async function fetchInventory() {
      try {
        const useMock = process.env.NEXT_PUBLIC_FEATURE_USE_MOCK === 'true'
        // TODO: cambiare fetch backend se backend disponibile
        if (useMock) {
          const res = await fetch(MOCK_DATA_URL)
          if (!res.ok) throw new Error('Impossibile caricare dati mock')
          const data: InventoryItem[] = await res.json()
          setItems(data)
        } else {
          // Esempio fetch reale
          const apiBase = process.env.NEXT_PUBLIC_API_BASE_URL
          if (!apiBase) throw new Error('API base URL non definito')
          const res = await fetch(`${apiBase}/inventory`)
          if (!res.ok) throw new Error('Errore caricamento inventario backend')
          const data: InventoryItem[] = await res.json()
          setItems(data)
        }
        setError(null)
      } catch (err) {
        setError((err as Error).message)
      } finally {
        setLoading(false)
      }
    }
    fetchInventory()
  }, [])

  return (
    <section>
      <h2 className="text-xl font-semibold mb-4">Elenco Inventario</h2>
      {loading && (
        <p role="status" aria-live="polite">
          Caricamento inventario…
        </p>
      )}
      {error && (
        <p role="alert" className="text-red-600">
          Errore: {error}
        </p>
      )}
      {!loading && !error && items.length === 0 && <p>Nessun articolo trovato</p>}
      {!loading && !error && items.length > 0 && (
        <ul className="divide-y border rounded bg-white">
          {items.map(({ id, name, description, quantity }) => (
            <li key={id} className="p-4 flex justify-between items-center hover:bg-gray-50">
              <div className="flex flex-col">
                <Link
                  href={`/inventory/${encodeURIComponent(id)}`}
                  className="text-blue-600 font-semibold hover:underline"
                >
                  {name}
                </Link>
                <span className="text-sm text-gray-600">{description}</span>
              </div>
              <div className="font-mono text-gray-700" aria-label={`Quantità disponibile: ${quantity}`}>
                {quantity}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}